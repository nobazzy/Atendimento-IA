# PORTA DO PAINEL WEB
PORT=3000

# SEU NÚMERO DE WHATSAPP (Ex: 5511999999999)
MY_NUMBER=

# PROVEDOR ATIVO DA IA
# Opções: 'openai' | 'gemini' | 'claude' | 'groq' | 'deepseek' | 'ollama' | 'lmstudio' | 'custom'
ACTIVE_PROVIDER=openai

# OPENAI (GPT-4o, GPT-4o-mini)
USE_OPENAI=true
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# GOOGLE GEMINI (Gemini 1.5 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ANTHROPIC CLAUDE (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# GROQ CLOUD (Llama 3.3 70B - Ultra Rápido)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# DEEPSEEK API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# OLLAMA (Execução 100% Local Gratuita)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:14b

# LM STUDIO (Execução Local via GUI)
LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=local-model

# ENPOINT CUSTOMIZADO (OpenRouter, vLLM, etc)
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
