# =====================================================================
# ⚙️ ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env) - CENTRAL DE ATENDIMENTO IA
# =====================================================================
# Copie este arquivo para ".env" e preencha com suas configurações:
# cp .env.example .env

# =====================================================================
# 🔐 SEGURANÇA E PROTEÇÃO DA API / PAINEL WEB
# =====================================================================
# Ativar exigência de autenticação (recomendado 'true' em VPS / produção)
REQUIRE_AUTH=false

# Senha mestra do painel administrativo e token de API
ADMIN_PASSWORD=admin123

# Chave secreta de assinatura JWT (se em branco, gerada aleatoriamente ao iniciar)
JWT_SECRET=

# Desativar encerramento remoto do processo via painel (true recomendado em VPS)
DISABLE_KILL_SWITCH=false

# 🌐 PORTA DO SERVIDOR WEB E PAINEL ADMINISTRATIVO
PORT=3000

# 📲 SEU NÚMERO DO WHATSAPP COM DDI + DDD (Apenas números, ex: 5511999998888)
# Opcional, mas recomendado para ignorar respostas no seu próprio chat
MY_NUMBER=

# =====================================================================
# 🤖 SELEÇÃO DO PROVEDOR DE INTELIGÊNCIA ARTIFICIAL ATIVO
# Opções válidas:
#  - 'openai'    : OpenAI oficial (GPT-4o, GPT-4o-mini)
#  - 'gemini'    : Google Gemini oficial (Gemini 1.5 Flash / Pro)
#  - 'claude'    : Anthropic Claude (Claude 3.5 Sonnet)
#  - 'groq'      : Groq Cloud (Ultra rápido - Llama 3.3 70B)
#  - 'deepseek'  : DeepSeek API oficial (DeepSeek Chat / V3)
#  - 'ollama'    : Ollama local (100% grátis e offline na sua máquina)
#  - 'lmstudio'  : LM Studio local (porta 1234)
#  - 'custom'    : Endpoint personalizado compatível com OpenAI (OpenRouter, etc.)
# =====================================================================
ACTIVE_PROVIDER=openai

# ---------------------------------------------------------------------
# 1. OPENAI CONFIGURATION
# Obtenha sua chave em: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------
USE_OPENAI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# 2. GOOGLE GEMINI CONFIGURATION
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE CONFIGURATION
# Obtenha sua chave em: https://console.anthropic.com/
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------
# 4. GROQ CLOUD (INFERÊNCIA ULTRA RÁPIDA)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# 5. DEEPSEEK OFFICIAL API
# Obtenha sua chave em: https://platform.deepseek.com/
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------
# 6. OLLAMA LOCAL (100% OFFLINE E GRATUITO NO SEU PC)
# Baixe em: https://ollama.com
# Execute no terminal: ollama run qwen2.5:14b (ou llama3.2, etc.)
# ---------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------
# 7. LM STUDIO LOCAL
# Baixe em: https://lmstudio.ai
# ---------------------------------------------------------------------
LMSTUDIO_URL=http://localhost:1234/v1/chat/completions
LMSTUDIO_MODEL=local-model

# ---------------------------------------------------------------------
# 8. CUSTOM OPENAI-COMPATIBLE ENDPOINT (OpenRouter, RunPod, vLLM, etc.)
# ---------------------------------------------------------------------
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
